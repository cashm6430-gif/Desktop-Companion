; Temporary 3D rendering gate. Canonical GLB is staged by tools/review_toon_prototype.py.
config_version=5

[application]
config/name="Desktop Companion - 3D Technical Prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)

[display]
window/size/viewport_width=360
window/size/viewport_height=420
window/size/window_width_override=360
window/size/window_height_override=420
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/no_focus=true
window/per_pixel_transparency/allowed=true
window/stretch/mode="canvas_items"

[rendering]
viewport/transparent_background=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 0)

[physics]
common/physics_ticks_per_second=60
