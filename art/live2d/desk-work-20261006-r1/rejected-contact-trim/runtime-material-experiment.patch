+void CubismMaterialTextureTest::deskTrimPreservesSourceAndOutsideBytes() {
+    QImage source(10, 6, QImage::Format_RGBA8888_Premultiplied);
+    for (int y = 0; y < source.height(); ++y) {
+        for (int x = 0; x < source.width(); ++x)
+            source.setPixelColor(x, y, QColor(30 + x * 11, 40 + y * 18, 190, 100 + x * 12));
+    }
+    source.setDevicePixelRatio(2.0); // Atlas coordinates must remain physical pixels.
+    const QImage original = source.copy();
+    const QJsonArray first{QJsonArray{2, 2}, QJsonArray{5, 2}, QJsonArray{5, 4}, QJsonArray{2, 4}};
+    // Opposite polygon winding must still mean the union of kept material.
+    const QJsonArray second{QJsonArray{3, 2}, QJsonArray{3, 4}, QJsonArray{6, 4}, QJsonArray{6, 2}};
+    auto contract = deskContract(source.size(), QJsonArray{
+        deskRegion(QJsonArray{1, 1, 7, 5}, QJsonArray{first, second})});
+    contract.insert(QStringLiteral("source_sha256"), QStringLiteral("extra provenance is permitted"));
+    QImage trimmed;
+    QString error;
+    QVERIFY2(trimCubismDeskTexture(source, contract, &trimmed, &error), qPrintable(error));
+    QVERIFY(error.isEmpty());
+    QCOMPARE(source, original);
+    QCOMPARE(trimmed.devicePixelRatio(), source.devicePixelRatio());
+    verifyPremultiplied(trimmed);
+    for (int y = 0; y < source.height(); ++y) {
+        for (int x = 0; x < source.width(); ++x) {
+            if (x >= 1 && x < 7 && y >= 1 && y < 5) continue;
+            QVERIFY(std::memcmp(source.constScanLine(y) + 4 * x,
+                                trimmed.constScanLine(y) + 4 * x, 4) == 0);
+        }
+    }
+    QCOMPARE(trimmed.pixel(3, 2), source.pixel(3, 2)); // Overlapping keep polygons do not cancel.
+    QCOMPARE(trimmed.pixel(5, 2), source.pixel(5, 2));
+    for (int channel = 0; channel < 4; ++channel)
+        QCOMPARE(trimmed.constScanLine(1)[4 + channel], uchar(0));
+}
