+void CubismMaterialTextureTest::deskAntialiasKeepsPremultipliedColour() {
+    QImage source(8, 8, QImage::Format_RGBA8888_Premultiplied);
+    source.fill(QColor(80, 140, 230, 173));
+    const auto original = source.copy();
+    const QJsonArray triangle{QJsonArray{1.25, 1.25}, QJsonArray{6.75, 1.25}, QJsonArray{1.25, 6.75}};
+    const auto contract = deskContract(source.size(), QJsonArray{
+        deskRegion(QJsonArray{0, 0, 8, 8}, QJsonArray{QJsonValue(triangle)})});
+    QImage trimmed;
+    QString error;
+    QVERIFY2(trimCubismDeskTexture(source, contract, &trimmed, &error), qPrintable(error));
+    QCOMPARE(source, original);
+    verifyPremultiplied(trimmed);
+    int antialiasedSamples = 0;
+    for (int y = 0; y < trimmed.height(); ++y) {
+        for (int x = 0; x < trimmed.width(); ++x) {
+            const auto* pixel = trimmed.constScanLine(y) + 4 * x;
+            const auto* before = source.constScanLine(y) + 4 * x;
+            QVERIFY(pixel[3] <= before[3]);
+            if (pixel[3] == 0) {
+                for (int channel = 0; channel < 3; ++channel) QCOMPARE(pixel[channel], uchar(0));
+            }
+            if (pixel[3] >= 32 && pixel[3] < before[3]) {
+                ++antialiasedSamples;
+                const auto colour = trimmed.pixelColor(x, y);
+                const auto painted = source.pixelColor(x, y);
+                QVERIFY(std::abs(colour.red() - painted.red()) <= 4);
+                QVERIFY(std::abs(colour.green() - painted.green()) <= 4);
+                QVERIFY(std::abs(colour.blue() - painted.blue()) <= 4);
+            }
+        }
+    }
+    QVERIFY(antialiasedSamples > 0);
+}
