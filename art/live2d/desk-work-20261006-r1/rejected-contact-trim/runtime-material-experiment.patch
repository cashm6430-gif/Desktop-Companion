+bool trimCubismDeskTexture(const QImage& source, const QJsonObject& contract,
+                           QImage* trimmed, QString* error) {
+    if (error) error->clear();
+    const auto fail = [error](const QString& reason) {
+        if (error) *error = reason;
+        return false;
+    };
+    if (!trimmed || source.isNull()
+        || source.format() != QImage::Format_RGBA8888_Premultiplied) {
+        return fail(QStringLiteral("Desk material requires a premultiplied RGBA source and an output."));
+    }
+    const auto version = contract.value(QStringLiteral("version"));
+    if (!version.isDouble() || version.toDouble() != 1.0) {
+        return fail(QStringLiteral("Desk material contract version must be 1."));
+    }
+    const auto integerWithin = [](const QJsonValue& value, int maximum) {
+        const double number = value.toDouble(-1.0);
+        return value.isDouble() && std::isfinite(number) && number >= 0.0
+            && number <= maximum && std::floor(number) == number;
+    };
+    const auto sizeValue = contract.value(QStringLiteral("atlas_size"));
+    const auto size = sizeValue.toArray();
+    if (!sizeValue.isArray() || size.size() != 2
+        || !integerWithin(size[0], source.width()) || !integerWithin(size[1], source.height())
+        || size[0].toInt() != source.width() || size[1].toInt() != source.height()) {
+        return fail(QStringLiteral("Desk material atlas_size must match the source image."));
+    }
+    const auto regionsValue = contract.value(QStringLiteral("regions"));
+    if (!regionsValue.isArray()) {
+        return fail(QStringLiteral("Desk material regions must be an array."));
+    }
+    struct Region {
+        QRect rect;
+        QPainterPath keep;
+    };
+    QVector<Region> regions;
+    for (const auto& value : regionsValue.toArray()) {
+        if (!value.isObject()) return fail(QStringLiteral("Desk material region must be an object."));
+        const auto object = value.toObject();
+        const auto drawable = object.value(QStringLiteral("drawableId"));
+        if (!drawable.isString() || drawable.toString().trimmed().isEmpty()) {
+            return fail(QStringLiteral("Desk material region requires a drawableId."));
+        }
+        const auto rectValue = object.value(QStringLiteral("atlas_rect"));
+        const auto bounds = rectValue.toArray();
+        if (!rectValue.isArray() || bounds.size() != 4
+            || !integerWithin(bounds[0], source.width()) || !integerWithin(bounds[2], source.width())
+            || !integerWithin(bounds[1], source.height()) || !integerWithin(bounds[3], source.height())
+            || bounds[0].toInt() >= bounds[2].toInt() || bounds[1].toInt() >= bounds[3].toInt()) {
+            return fail(QStringLiteral("Desk material atlas_rect must be a nonempty integer region inside the atlas."));
+        }
+        const int left = bounds[0].toInt(), top = bounds[1].toInt();
+        const int right = bounds[2].toInt(), bottom = bounds[3].toInt();
+        Region region{QRect(left, top, right - left, bottom - top), {}};
+        for (const auto& previous : regions) {
+            if (region.rect.intersects(previous.rect)) {
+                return fail(QStringLiteral("Desk material regions must not overlap."));
+            }
+        }
+        const auto polygonsValue = object.value(QStringLiteral("keep_polygons"));
+        if (!polygonsValue.isArray()) {
+            return fail(QStringLiteral("Desk material keep_polygons must be an array."));
+        }
+        for (const auto& polygonValue : polygonsValue.toArray()) {
+            if (!polygonValue.isArray() || polygonValue.toArray().size() < 3) {
+                return fail(QStringLiteral("Desk material keep polygon requires at least three points."));
+            }
+            QPolygonF polygon;
+            for (const auto& pointValue : polygonValue.toArray()) {
+                const auto point = pointValue.toArray();
+                if (!pointValue.isArray() || point.size() != 2
+                    || !point[0].isDouble() || !point[1].isDouble()
+                    || !std::isfinite(point[0].toDouble()) || !std::isfinite(point[1].toDouble())
+                    || point[0].toDouble() < left || point[0].toDouble() > right
+                    || point[1].toDouble() < top || point[1].toDouble() > bottom) {
+                    return fail(QStringLiteral("Desk material keep points must be finite coordinates inside their region."));
+                }
+                polygon.append(QPointF(point[0].toDouble(), point[1].toDouble()));
+            }
+            QPainterPath path;
+            path.addPolygon(polygon);
+            path.closeSubpath();
+            region.keep = region.keep.united(path);
+        }
+        regions.append(std::move(region));
+    }
+
+    // Validate the complete contract before painting a detached copy. Cutting
+    // premultiplied RGB and alpha together preserves coloured antialias edges.
+    QImage result = source.copy();
+    if (result.isNull()) return fail(QStringLiteral("Could not allocate the desk material image."));
+    // Contract coordinates are physical atlas pixels, even for a HiDPI image.
+    const qreal sourceRatio = result.devicePixelRatio();
+    result.setDevicePixelRatio(1.0);
+    QPainter painter(&result);
+    if (!painter.isActive()) return fail(QStringLiteral("Could not paint the desk material image."));
+    painter.setRenderHint(QPainter::Antialiasing, true);
+    painter.setCompositionMode(QPainter::CompositionMode_DestinationOut);
+    for (const auto& region : regions) {
+        QPainterPath extent;
+        extent.addRect(QRectF(region.rect));
+        painter.save();
+        // Integer clipping confines AA coverage to this chart's pixel bounds.
+        painter.setClipRegion(QRegion(region.rect), Qt::ReplaceClip);
+        painter.fillPath(extent.subtracted(region.keep), Qt::black);
+        painter.restore();
+    }
+    painter.end();
+    result.setDevicePixelRatio(sourceRatio);
+    *trimmed = std::move(result);
+    return true;
+}
