 void CubismMaterialTextureTest::exportedWhaleGirlHasOneNeckAndSeparateClothing() {
     const QDir directory(QDir(QCoreApplication::applicationDirPath())
         .filePath(QStringLiteral("assets/live2d/whale-girl")));
