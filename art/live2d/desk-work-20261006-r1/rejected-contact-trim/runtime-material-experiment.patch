+void CubismMaterialTextureTest::invalidDeskContractsLeaveOutputIntact() {
+    QImage source(4, 4, QImage::Format_RGBA8888_Premultiplied);
+    source.fill(QColor(80, 140, 230, 173));
+    const auto original = source.copy();
+    const QJsonArray polygon{QJsonArray{1, 1}, QJsonArray{3, 1}, QJsonArray{1, 3}};
+    const auto region = deskRegion(QJsonArray{1, 1, 3, 3}, QJsonArray{QJsonValue(polygon)});
+    const auto valid = deskContract(source.size(), QJsonArray{region});
+    QImage trimmed(1, 1, QImage::Format_RGBA8888);
+    trimmed.fill(QColor(20, 30, 40, 255));
+    const auto sentinel = trimmed.copy();
+    QString error;
+    const auto verifyFailure = [&](const QJsonObject& contract, const QImage& input) {
+        error.clear();
+        QVERIFY(!trimCubismDeskTexture(input, contract, &trimmed, &error));
+        QVERIFY(!error.isEmpty());
+        QCOMPARE(trimmed, sentinel);
+        QCOMPARE(source, original);
+    };
+    auto bad = valid;
+    bad.insert(QStringLiteral("version"), 2);
+    verifyFailure(bad, source);
+    bad = valid;
+    bad.insert(QStringLiteral("atlas_size"), QJsonArray{5, 4});
+    verifyFailure(bad, source);
+    bad = valid;
+    bad.insert(QStringLiteral("regions"), QStringLiteral("invalid"));
+    verifyFailure(bad, source);
+    bad = valid;
+    bad.insert(QStringLiteral("regions"), QJsonArray{42});
+    verifyFailure(bad, source);
+    for (const QJsonArray rect : {QJsonArray{-1, 1, 3, 3}, QJsonArray{1, 1, 5, 3},
+         QJsonArray{3, 1, 1, 3}, QJsonArray{1, 1, 1, 3}, QJsonArray{1.25, 1, 3, 3},
+         QJsonArray{1, 1, 3}, QJsonArray{1, "bad", 3, 3}}) {
+        auto invalid = region;
+        invalid.insert(QStringLiteral("atlas_rect"), rect);
+        // A valid first region must not be published before the later failure.
+        verifyFailure(deskContract(source.size(), QJsonArray{region, invalid}), source);
+    }
+    for (const QJsonArray points : {QJsonArray{QJsonArray{1, 1}, QJsonArray{2, 2}},
+         QJsonArray{QJsonArray{0, 1}, QJsonArray{3, 1}, QJsonArray{1, 3}},
+         QJsonArray{QJsonArray{1, 1, 0}, QJsonArray{3, 1}, QJsonArray{1, 3}},
+         QJsonArray{QJsonArray{1, "bad"}, QJsonArray{3, 1}, QJsonArray{1, 3}},
+         QJsonArray{QJsonArray{1, std::numeric_limits<double>::infinity()}, QJsonArray{3, 1}, QJsonArray{1, 3}}}) {
+        auto invalid = region;
+        invalid.insert(QStringLiteral("keep_polygons"), QJsonArray{QJsonValue(points)});
+        verifyFailure(deskContract(source.size(), QJsonArray{invalid}), source);
+    }
+    auto invalid = region;
+    invalid.insert(QStringLiteral("drawableId"), QStringLiteral(""));
+    verifyFailure(deskContract(source.size(), QJsonArray{invalid}), source);
+    invalid = region;
+    invalid.insert(QStringLiteral("keep_polygons"), QStringLiteral("invalid"));
+    verifyFailure(deskContract(source.size(), QJsonArray{invalid}), source);
+    verifyFailure(deskContract(source.size(), QJsonArray{region, region}), source);
+    verifyFailure(valid, QImage());
+    verifyFailure(valid, source.convertToFormat(QImage::Format_RGBA8888));
+    QVERIFY(!trimCubismDeskTexture(source, valid, nullptr, &error));
+    QVERIFY(!error.isEmpty());
+    QCOMPARE(trimmed, sentinel);
+}
