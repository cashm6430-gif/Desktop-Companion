+void CubismMaterialTextureTest::deskEmptyKeepClearsOnlyItsRegion() {
+    auto source = sampleAtlas().convertToFormat(QImage::Format_RGBA8888_Premultiplied);
+    const auto original = source.copy();
+    const auto contract = deskContract(source.size(), QJsonArray{
+        deskRegion(QJsonArray{1, 0, 3, 1}, QJsonArray{})});
+    // Staging the copy also makes an explicitly aliased output safe.
+    QVERIFY(trimCubismDeskTexture(source, contract, &source));
+    for (int x = 1; x < 3; ++x) {
+        for (int channel = 0; channel < 4; ++channel)
+            QCOMPARE(source.constScanLine(0)[4 * x + channel], uchar(0));
+    }
+    for (int x : {0, 3}) {
+        QVERIFY(std::memcmp(source.constScanLine(0) + 4 * x,
+                            original.constScanLine(0) + 4 * x, 4) == 0);
+    }
+    QImage unchanged;
+    QVERIFY(trimCubismDeskTexture(original, deskContract(original.size(), QJsonArray{}), &unchanged));
+    QCOMPARE(unchanged, original);
+    verifyPremultiplied(source);
+}
